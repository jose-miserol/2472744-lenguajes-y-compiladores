import time

def generar_polinomio_python(n):
    if n == 0:
        return [1]
    
    fila_anterior = [1]
    for _ in range(1, n + 1):
        fila_actual = [1]
        for i in range(len(fila_anterior) - 1):
            fila_actual.append(fila_anterior[i] + fila_anterior[i+1])
        fila_actual.append(1)
        fila_anterior = fila_actual
    return fila_anterior

def evaluar_polinomio(coefs, x):
    n = len(coefs) - 1
    pasos = []
    resultado = 0
    for i, c in enumerate(coefs):
            potencia = n - i
            termino = c * (x ** potencia)
            resultado += termino
            pasos.append(f"{c}*(x^{potencia}) = {termino}")
    return resultado, pasos

def medir_tiempo_python():
    inicio = time.perf_counter()
    for _ in range(100):
        generar_polinomio_python(100)
    fin = time.perf_counter()
    return fin - inicio

if __name__ == "__main__":
    n = 6
    coefs = generar_polinomio_python(n)
    print(f"Polinomio (x+1)^{n}: {coefs}")
    res, pasos = evaluar_polinomio(coefs, 2)
    print(f"Evaluado en x=2: {res}")
    tiempo = medir_tiempo_python()
    print(f"Tiempo Python (100 iteraciones para n=100): {tiempo:.6f} s")